<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no">

<title>Bolt Bokeh</title>
<meta name="description" content="Simulated lightning-bolt bokeh for previewing a custom aperture matte.">

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Bolt Bokeh">
<meta name="theme-color" content="#08090b">

<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" href="./icons/icon-180.png">
<link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png">
<link rel="stylesheet" href="./css/styles.css">
</head>
<body>

<div id="stage">
  <video id="cam" playsinline muted autoplay></video>
  <canvas id="view"></canvas>

  <div id="hud" style="display:none">
    <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-start;">
      <div class="chip" id="fxchip">BOKEH <span class="v" id="fxstate">ON</span></div>
      <div id="readout">--</div>
    </div>
    <div class="chip" id="rotchip">ROT <span class="v" id="rotval">0&deg;</span></div>
  </div>

  <div id="gate">
    <h1>Bolt Bokeh</h1>
    <p>Replaces bright highlights with lightning-bolt bokeh. A rendered simulation for showing the look, not a preview of what the lens will do.</p>
    <button class="btn primary" id="pickbtn">Take or choose a photo</button>
    <button class="btn" id="start">Use live camera</button>
    <input type="file" id="pick" accept="image/*" style="display:none">
    <div class="err" id="err" style="display:none"></div>
    <button class="link" id="diagbtn">Show diagnostics</button>
    <pre id="diag" style="display:none"></pre>
    <div id="openself"></div>
  </div>
</div>

<div id="bar">
  <div id="row">
    <div class="sq" id="gear">&#9776;</div>
    <div id="shutter"></div>
    <div class="sq" id="srcbtn">&#8644;</div>
  </div>

  <div id="panel">
    <div class="grp">
      <div class="ctl">
        <div class="lab">Bolt rotation <b id="v_rot">0&deg;</b></div>
        <input type="range" id="s_rot" min="-180" max="180" step="1" value="0">
        <div class="snaps">
          <div class="snap" data-rot="-90">-90</div>
          <div class="snap" data-rot="-45">-45</div>
          <div class="snap on" data-rot="0">0</div>
          <div class="snap" data-rot="45">45</div>
          <div class="snap" data-rot="90">90</div>
          <div class="snap" data-rot="180">180</div>
        </div>
      </div>

      <div class="ctl">
        <div class="lab">Bokeh size <b id="v_size">13.0%</b></div>
        <input type="range" id="s_size" min="30" max="260" step="1" value="130">
      </div>
      <div class="ctl">
        <div class="lab">Defocus <b id="v_blur">medium</b></div>
        <input type="range" id="s_blur" min="0" max="100" step="1" value="55">
      </div>
      <div class="ctl">
        <div class="lab">Highlight threshold <b id="v_thr">0.58</b></div>
        <input type="range" id="s_thr" min="15" max="96" step="1" value="58">
      </div>
      <div class="ctl">
        <div class="lab">Bokeh brightness <b id="v_gain">1.00</b></div>
        <input type="range" id="s_gain" min="20" max="250" step="1" value="100">
      </div>
      <div class="ctl">
        <div class="lab">Background level <b id="v_bg">50%</b></div>
        <input type="range" id="s_bg" min="0" max="100" step="1" value="50">
      </div>
      <div class="ctl">
        <div class="lab">Max bokeh count <b id="v_max">70</b></div>
        <input type="range" id="s_max" min="4" max="160" step="1" value="70">
      </div>

      <button class="reset" id="resetbtn">Reset to defaults</button>
      <div class="note">
        Point at small separated practicals against a dark background. Raise the threshold until
        only the lights trigger. Tap BOKEH at top-left to A/B against the plain image.
        The bottom-right button swaps camera, or loads a different photo.
      </div>
    </div>
  </div>
</div>

<div id="shot">
  <img id="shotimg" alt="capture">
  <div id="shotrow">
    <button class="btn" id="shotback">Back</button>
    <button class="btn primary" id="shotsave">Save</button>
  </div>
  <div id="shotnote">On iPhone you can also press and hold the image and choose Add to Photos.</div>
</div>

<script src="./js/app.js"></script>
</body>
</html>
